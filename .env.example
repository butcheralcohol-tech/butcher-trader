# Server settings
PORT=8787
APP_ORIGIN=http://localhost:5173
# Public Deriv app ID used by the browser for market data; also set the server-only DERIV_APP_ID below.
VITE_DERIV_APP_ID=1089
DERIV_APP_ID=1089
# Optional override for the authenticated server-side trading WebSocket (must be wss://).
DERIV_TRADING_WS_URL=wss://ws.derivws.com/websockets/v3?app_id=1089
# OAuth client ID exactly as shown for your registered Deriv OAuth app.
VITE_DERIV_OAUTH_CLIENT_ID=
DERIV_OAUTH_CLIENT_ID=
# Must exactly match the redirect URL registered with Deriv.
DERIV_OAUTH_REDIRECT_URI=https://butcherfx.vercel.app/deriv/callback
# Generate a random value of at least 32 characters; server-only, never VITE_.
SESSION_SECRET=
# Required for demo order execution: Upstash Redis REST durable idempotency, locking, and audit records.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Never put an account token or secret in VITE_ variables or commit it to GitHub.
# Only verified VRTC demo accounts are accepted; real-money execution is hard-blocked.

# ---- Real-money trading: OFF unless ALL of these are set deliberately. Demo accounts never need them. ----
# Must be exactly this value to enable real accounts at all ("true" does not work):
# ALLOW_REAL_TRADING=I_ACCEPT_REAL_MONEY_LOSSES
# Exact real account login ID(s), comma separated. Any other account is refused:
# REAL_ACCOUNT_ALLOWLIST=CR1234567
# Hard caps (no defaults). Effective stake is also capped at 1% of balance, daily loss at 3% of balance:
# REAL_MAX_STAKE=1
# REAL_DAILY_LOSS_LIMIT=5
# Broker-confirmed demo orders required first (minimum 30):
# REAL_MIN_DEMO_ORDERS=30
# Emergency kill switch: set to true and redeploy to halt ALL orders (demo and real):
# TRADING_HALTED=false
