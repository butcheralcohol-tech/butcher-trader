# Server settings
PORT=8787
APP_ORIGIN=http://localhost:5173
# Public Deriv app ID used by the browser for market-data WebSocket only.
VITE_DERIV_APP_ID=1089
# OAuth client ID is the numeric App ID from your registered Deriv OAuth app.
VITE_DERIV_OAUTH_CLIENT_ID=
DERIV_OAUTH_CLIENT_ID=
# Must exactly match the redirect URL registered with Deriv.
DERIV_OAUTH_REDIRECT_URI=https://butcher-trader-lemon.vercel.app/deriv/callback
# Generate a random value of at least 32 characters; server-only, never VITE_.
SESSION_SECRET=
# Never put an account token or secret in VITE_ variables or commit it to GitHub.
# Real-account execution remains disabled.
