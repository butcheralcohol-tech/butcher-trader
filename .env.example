# Server settings
PORT=8787
APP_ORIGIN=http://localhost:5173
# Public Deriv app ID used by the browser for market-data WebSocket only.
VITE_DERIV_APP_ID=1089
# Optional: force one Deriv market-data WebSocket instead of the default (new public socket, then legacy fallback).
# VITE_DERIV_WS_URL=wss://api.derivws.com/trading/v1/options/ws/public
# Optional public OAuth client ID for the Deriv connection setup screen.
VITE_DERIV_OAUTH_CLIENT_ID=
# OAuth backend settings are documented for the future secure callback; not yet consumed by this milestone.
DERIV_OAUTH_CLIENT_ID=
DERIV_OAUTH_CLIENT_SECRET=
DERIV_OAUTH_REDIRECT_URI=
SESSION_SECRET=
# Never put an account token or secret in VITE_ variables or commit it to GitHub.
# Real-account execution remains disabled.
