# Server settings
PORT=8787
APP_ORIGIN=http://localhost:5173
# Public Deriv app ID used by the browser for market data; also set the server-only DERIV_APP_ID below.
VITE_DERIV_APP_ID=1089
DERIV_APP_ID=1089
# Optional override for the authenticated server-side trading WebSocket (must be wss://).
DERIV_TRADING_WS_URL=wss://ws.derivws.com/websockets/v3?app_id=1089
# OAuth client ID exactly as shown for your registered Deriv OAuth app.
VITE_DERIV_OAUTH_CLIENT_ID=
DERIV_OAUTH_CLIENT_ID=
# Must exactly match the redirect URL registered with Deriv.
DERIV_OAUTH_REDIRECT_URI=https://butcherfx.vercel.app/deriv/callback
# Generate a random value of at least 32 characters; server-only, never VITE_.
SESSION_SECRET=
# Required for demo order execution: Upstash Redis REST durable idempotency, locking, and audit records.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Never put an account token or secret in VITE_ variables or commit it to GitHub.
# Demo (VRTC) accounts work with the settings above. Real (CR) accounts stay BLOCKED unless every setting below is set.

# ---- REAL MONEY (leave all blank to keep real trading off) ----
# Exact value required to unlock real accounts. Anything else = locked.
ALLOW_REAL_TRADING=
# Comma-separated real account IDs allowed to trade, e.g. CR1234567
REAL_ACCOUNT_ALLOWLIST=
# Hard caps with no defaults: max stake per trade and max daily loss (USD)
REAL_MAX_STAKE=
REAL_DAILY_LOSS_LIMIT=
# Demo orders that must be confirmed before real is allowed (minimum 30)
REAL_MIN_DEMO_ORDERS=30
# Emergency kill switch: set to true and redeploy to halt ALL orders.
# (Or set the Redis key butcher:halt to any value for an instant halt with no redeploy.)
TRADING_HALTED=
