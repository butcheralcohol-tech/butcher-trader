# Always-on robot worker. Build: docker build -f Dockerfile.worker -t butcher-worker .
FROM node:22-slim
WORKDIR /app
COPY package*.json ./
RUN npm ci
COPY shared ./shared
COPY worker ./worker
COPY tsconfig.json ./
ENV NODE_ENV=production
EXPOSE 8080
HEALTHCHECK --interval=60s --timeout=5s CMD node -e "fetch('http://localhost:'+(process.env.PORT||8080)+'/health').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"
CMD ["npx", "tsx", "worker/index.ts"]
